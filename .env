#
# Enviromental values for Makefile and for docker-compose.yml
#

# Docker Compose project name
COMPOSE_PROJECT_NAME=helfi-kuva
PROJECT_NAME=kuva

# Azure Blob storage location of the database dump used by 'make fresh'
AZURE_DUMP_CONTAINER=hki-database-blob-helfi-kuva-test

# Stage file proxy origin url and folder
STAGE_FILE_PROXY_ORIGIN=https://stplattaprod.blob.core.windows.net
STAGE_FILE_PROXY_ORIGIN_DIR=helfikuvaprod

COMPOSE_PROFILES=

# Local hostname
DRUPAL_HOSTNAME=helfi-kuva.docker.so

# Public webroot
DRUPAL_WEBROOT=public
